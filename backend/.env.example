# Copy to backend/.env and fill in. Never commit the real file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://research:research@localhost:5436/research

# Model (server-side only). Ordered fallback: when one model's daily quota is used up, the next is tried.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=low
DAILY_MODEL_CALL_LIMIT=200
# List prices (USD per 1M tokens) used to turn real token counts into cost. Check the provider's pricing page.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.40

# Search: "auto" uses Tavily when TAVILY_API_KEY is set, otherwise the keyless Wikipedia fallback.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# Caps on every run
MAX_SUB_QUESTIONS=5
MAX_PARALLEL_WORKERS=3
MAX_STEPS_PER_AGENT=2
DEFAULT_BUDGET_TOKENS=120000
RUN_TIMEOUT_SECONDS=600
MIN_INDEPENDENT_DOMAINS=2

# Browser access
FRONTEND_ORIGIN=http://localhost:5183
DEMO_ACCESS_CODE=
RUNS_PER_HOUR_PER_CLIENT=10
WORKER_MODE=inline
